VALIDATION_API_PORT=8765
# Disease classification model
ULTRALYTICS_PREDICT_URL=https://your-classification-url.run.app/predict
ULTRALYTICS_API_KEY=your_ultralytics_api_key
# Disease severity segmentation model. Uses ULTRALYTICS_API_KEY unless a
# different ULTRALYTICS_SEVERITY_API_KEY is provided.
ULTRALYTICS_SEVERITY_URL=https://predict-6af4d8cb3a83009cbe9bd1ba-dproatj77a-de.a.run.app/predict
# ULTRALYTICS_SEVERITY_API_KEY=your_severity_endpoint_api_key
ULTRALYTICS_SEVERITY_CONF=0.25
ULTRALYTICS_SEVERITY_IOU=0.5
ULTRALYTICS_SEVERITY_IMGSZ=640
# Image validation model (leaf check). /predict is added if you omit it.
ULTRALYTICS_VALIDATION_URL=https://predict-6ae37ce0bbd46ce898ad6e66-dproatj77a-df.a.run.app/predict

# Groq — AI care recommendations (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
# Optional; see https://console.groq.com/docs/models
# Run: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b
