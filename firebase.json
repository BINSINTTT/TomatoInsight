{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server/**",
      "**/*.py",
      "**/*.md",
      "venv/**",
      "**/.env"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/html/landing.html",
        "type": 302
      }
    ]
  }
}
